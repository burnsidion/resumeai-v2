# Optional. Defaults to "ResumAI" when omitted.
NUXT_PUBLIC_APP_NAME=ResumAI

# Required. Copy these public values from the Supabase project's Connect dialog.
NUXT_PUBLIC_SUPABASE_URL=

# Must start with "sb_publishable_". Never use a secret or service-role key.
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
