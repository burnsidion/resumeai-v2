# Optional. Defaults to "ResumAI" when omitted.
NUXT_PUBLIC_APP_NAME=ResumAI

# Required. Copy these public values from the Supabase project's Connect dialog.
NUXT_PUBLIC_SUPABASE_URL=

# Must start with "sb_publishable_". Never use a secret or service-role key.
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Required only when a server request explicitly runs AI tailoring. Never use
# the `NUXT_PUBLIC_` prefix, expose this value to the browser, or supply it as
# a Docker build argument.
OPENAI_API_KEY=

# Required with OPENAI_API_KEY. Configure an approved model explicitly; there
# is intentionally no repository default.
OPENAI_TAILORING_MODEL=
